# Postgres connection used by the running API
DATABASE_URL=postgresql+psycopg2://hopzero:hopzero@localhost:5432/hopzero

# Used only by the test suite (defaults to local sqlite file if unset)
TEST_DATABASE_URL=sqlite:///./test.db

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ARTIFACT_STORAGE_ROOT=./storage/artifacts

# Trusted deterministic-producer credential for the direct POST
# /findings endpoint (X-Internal-Service-Key header). There is NO
# hardcoded fallback in source -- if this is unset, that path is
# simply unavailable (Option-B behavior; see app/security.py).
# Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOPZERO_INTERNAL_SERVICE_KEY=

# Ingestion key for n8n webhook (X-N8N-Ingest-Key header)
HOPZERO_N8N_INGEST_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
