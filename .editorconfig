root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yaml,yml,html,css}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{eml,msg,png,jpg,jpeg,gif,ico,pdf,db,sqlite,sqlite3,zip,tar,gz,gguf,woff,woff2,ttf}]
insert_final_newline = false
trim_trailing_whitespace = false
