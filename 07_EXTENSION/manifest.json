{
  "manifest_version": 3,
  "name": "HopZero Analyst Extension",
  "version": "1.0.0",
  "description": "Interactive HopZero SOC analyst client for webmail platforms",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["src/styles/visual_scanner.css"],
      "js": ["src/content/gmail_adapter.js", "src/content/visual_scanner.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
