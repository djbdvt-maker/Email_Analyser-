FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY 03_BACKEND/requirements.txt ./03_BACKEND/
RUN pip install --no-cache-dir -r ./03_BACKEND/requirements.txt
RUN playwright install --with-deps chromium
RUN pip install --no-cache-dir requests

COPY 03_BACKEND/ ./03_BACKEND/
COPY 02_FORENSICS/ ./02_FORENSICS/
COPY 01_REGISTRY/ ./01_REGISTRY/

RUN mkdir -p /app/03_BACKEND/storage/artifacts
RUN mkdir -p /app/03_BACKEND/storage/alembic

WORKDIR /app/03_BACKEND

# Ensure all modules are accessible
ENV PYTHONPATH="/app:/app/03_BACKEND:/app/02_FORENSICS:/app/01_REGISTRY"

EXPOSE 8000

RUN chmod +x /app/03_BACKEND/entrypoint.sh
CMD ["/app/03_BACKEND/entrypoint.sh"]
