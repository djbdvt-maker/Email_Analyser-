+      // --- URL REPUTATION HEURISTICS ---
+      
+      // Excessive dashes (---)
+      if (domain.match(/-{3,}/)) {
+        threats.push({
+          type: 'suspicious-link',
+          reason: 'Domain contains excessive dashes (---)',
+          severity: this.SEVERITY.WARNING
+        });
+      }
