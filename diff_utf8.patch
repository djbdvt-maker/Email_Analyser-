diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..3b21e7c
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,40 @@
+name: CI
+
+on:
+  push:
+    branches: [ "main", "master" ]
+  pull_request:
+    branches: [ "main", "master" ]
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+    - uses: actions/checkout@v4
+    
+    - name: Set up Python
+      uses: actions/setup-python@v5
+      with:
+        python-version: '3.11'
+        cache: 'pip'
+        
+    - name: Set up Environment Variables
+      run: |
+        echo "DATABASE_URL=sqlite:///./test.db" > .env
+        echo "JWT_SECRET_KEY=test_secret_key" >> .env
+        echo "JWT_ALGORITHM=HS256" >> .env
+        echo "JWT_EXPIRE_MINUTES=60" >> .env
+        echo "HOPZERO_INTERNAL_SERVICE_KEY=test_internal_key" >> .env
+        echo "HOPZERO_N8N_INGEST_KEY=test_n8n_key" >> .env
+        
+    - name: Install Dependencies
+      run: |
+        python -m pip install --upgrade pip
+        pip install -r 03_BACKEND/requirements.txt
+        pip install pytest pytest-asyncio
+        
+    - name: Run Test Suite
+      run: |
+        pytest
+      env:
+        PYTHONPATH: .
