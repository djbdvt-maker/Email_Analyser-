# ==============================================================================
# HopZero Email Forensics & BotChain Tool Suite - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # 'development' | 'production' | 'test'
HOPZERO_PORTABLE=0                     # Set to 1 to use ./storage rather than OS AppData

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Desktop / Lite / Standard Editions: uses zero-config local SQLite
# Server Edition: uses PostgreSQL
DATABASE_URL=sqlite:///./storage/hopzero.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://hopzero:hopzero@localhost:5432/hopzero

# Test database connection (isolated SQLite by default)
TEST_DATABASE_URL=sqlite:///./test.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# REQUIRED in production: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Trusted deterministic ingestion keys (No default fallbacks)
# Set these if using n8n or internal ingestion workers
HOPZERO_INTERNAL_SERVICE_KEY=
HOPZERO_N8N_INGEST_KEY=
HOPZERO_API_KEY=sih-extension-demo-key

# ------------------------------------------------------------------------------
# 4. STORAGE & FORENSIC ARTIFACTS
# ------------------------------------------------------------------------------
# Directory for raw parsed emails and unpacked attachments
ARTIFACT_STORAGE_ROOT=./storage/artifacts

# ------------------------------------------------------------------------------
# 5. LOCAL AI REASONER & INFERENCE
# ------------------------------------------------------------------------------
HOPZERO_LLM_PROVIDER=ollama             # 'ollama' | 'openai' | 'offline_deterministic_fallback'
HOPZERO_LLM_BASE_URL=http://localhost:11434
HOPZERO_LLM_MODEL=hermes3:3b            # Verified resident model (< 4 GB VRAM)
HOPZERO_LLM_TIMEOUT_SECONDS=30.0

# Optional OpenAI / Hosted provider API key (if provider is set to 'openai')
HOPZERO_LLM_API_KEY=

# ------------------------------------------------------------------------------
# 6. PARSER ISOLATION & RESOURCE LIMITS
# ------------------------------------------------------------------------------
PARSER_ISOLATION_MODE=subprocess        # 'subprocess' (recommended) | 'process_pool' | 'in_process'
PARSER_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 7. NETWORKING & CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 8. ENTERPRISE COMMERCIAL LICENSING & RELEASE SIGNING (Ed25519)
# ------------------------------------------------------------------------------
# Optional custom trusted Ed25519 public keys (hex/base64, comma-separated)
# The application contains official embedded public keys by default.
# HOPZERO_TRUSTED_LICENSE_PUBLIC_KEYS=
# HOPZERO_TRUSTED_RELEASE_PUBLIC_KEYS=
# Commercial offline license key string (token: HZ-<EDITION>-<PAYLOAD>-<SIG>)
# HOPZERO_LICENSE_KEY=

